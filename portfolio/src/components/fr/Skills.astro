---
import Icon from '.././Icon.astro';
import '../../styles/skills.css';
---

<div><h1>Langages de programmation</h1></div>
<section class="box skills">
	<h2>Compétences</h2>

	<div class="skills-categories">
		<!-- Frontend -->
		<div class="category">
			<h3 class="category-title">Frontend</h3>
			<div class="skills-grid">
				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/html-5.png" alt="HTML5"/>
					<div class="skill-body">
						<h4 class="skill-name">HTML5 <span class="skill-level">Expert</span></h4>
						<p class="skill-desc">Structure sémantique et accessibilité</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/css3.png" alt="CSS3"/>
					<div class="skill-body">
						<h4 class="skill-name">CSS3 <span class="skill-level">Confirmé</span></h4>
						<p class="skill-desc">Responsive, animations, layout modernes</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/javascript.png" alt="Javascript"/>
					<div class="skill-body">
						<h4 class="skill-name">JavaScript <span class="skill-level">Confirmé</span></h4>
						<p class="skill-desc">DOM, ES6+, fetch, petites interactions</p>
					</div>
				</article>
			</div>
		</div>

		<!-- Backend -->
		<div class="category">
			<h3 class="category-title">Backend</h3>
			<div class="skills-grid">
				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/php.png" alt="PHP"/>
					<div class="skill-body">
						<h4 class="skill-name">PHP <span class="skill-level">Intermédiaire</span></h4>
						<p class="skill-desc">APIs, templating, gestion serveur</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/mysql-logo.png" alt="MySQL"/>
					<div class="skill-body">
						<h4 class="skill-name">MySQL <span class="skill-level">Intermédiaire</span></h4>
						<p class="skill-desc">Modélisation et requêtes</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/java-coffee-cup-logo.png" alt="Java"/>
					<div class="skill-body">
						<h4 class="skill-name">Java <span class="skill-level">Débutant</span></h4>
						<p class="skill-desc">Bases orientées objet et framework</p>
					</div>
				</article>
			</div>
		</div>

		<!-- Outils -->
		<div class="category">
			<h3 class="category-title">Outils & DevOps</h3>
			<div class="skills-grid">
				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/git.png" alt="Git"/>
					<div class="skill-body">
						<h4 class="skill-name">Git <span class="skill-level">Confirmé</span></h4>
						<p class="skill-desc">Versioning, branches, workflow</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/bootstrap.png" alt="Bootstrap"/>
					<div class="skill-body">
						<h4 class="skill-name">Bootstrap <span class="skill-level">Intermédiaire</span></h4>
						<p class="skill-desc">Composants et utilitaires rapides</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/sql.png" alt="SQL"/>
					<div class="skill-body">
						<h4 class="skill-name">SQL <span class="skill-level">Intermédiaire</span></h4>
						<p class="skill-desc">Requêtes, jointures et optimisation</p>
					</div>
				</article>
			</div>
		</div>
	</div>

