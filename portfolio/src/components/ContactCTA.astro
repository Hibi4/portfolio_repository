---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
import type { ProjectLang } from '../data/projects';

interface Props {
	lang?: ProjectLang;
}

const { lang = 'fr' } = Astro.props;

const content = {
	fr: {
		heading: 'Intéressé par une collaboration ?',
		button: 'Envoyez-moi un message',
	},
	en: {
		heading: 'Interested in a collaboration?',
		button: 'Send me a message',
	},
} as const;

const t = content[lang];
const email = 'mailto:albertroy1947@gmail.com';
---

<aside>
	<h2>{t.heading}</h2>
	<CallToAction href={email}>
		{t.button}
		<Icon icon="paper-plane-tilt" size="1.2em" />
	</CallToAction>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 15ch;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: space-between;
		}

		h2 {
			font-size: var(--text-3xl);
			text-align: left;
		}
	}
</style>
