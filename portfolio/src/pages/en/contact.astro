---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Hero from "../../components/Hero.astro";
import ContactCTA from '../../components/ContactCTA.astro';
---

<BaseLayout
    title="Contact "
    description="The page to allow users, visitors to contact me."
>
    <div class="contact">
        <main class="wrapper contact">
            
        <section class="contact-page">
            <div class="contact-grid">
                <aside class="contact-card contact-summary">
                    <span class="eyebrow">Contact</span>
                    <h1 id="comment__title">Let's build something together</h1>
                    <p class="contact-intro">
                        Send me a message for collaborations, freelance work, technical questions, or just to say hello.
                    </p>
                    <div class="contact-details">
                        <a href="mailto:albertroy1947@gmail.com">albertroy1947@gmail.com</a>
                        <a href="https://github.com/Hibi4" target="_blank" rel="noreferrer noopener">GitHub Profile</a>
                    </div>
                    <div class="contact-note">
                        I usually respond within 24 hours.
                    </div>
                </aside>

                <form
                    class="contact-card contact-form"
                    id="contact-form"
                    action={`https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_KEY}`}
                    method="POST"
                >
                    <label for="name">Name</label>
                    <input type="text" id="name" name="name" required />

                    <label for="email">Email</label>
                    <input
                        type="email"
                        id="email"
                        name="_replyto"
                        required
                    />

                    <label for="message">Message</label>
                    <textarea id="message" name="message" rows="6" required></textarea>

                    <input type="hidden" name="_next" value="/about.astro/" />
                    <button type="submit" aria-label="Send contact message">Send message</button>
                </form>
            </div>
            <ContactCTA lang="en" />
        </section>
        <style>
            .contact-page {
                padding: 3rem 0 1rem;
            }

            .contact-grid {
                display: grid;
                grid-template-columns: minmax(280px, 1fr) minmax(360px, 1.4fr);
                gap: 2rem;
                max-width: 88rem;
                margin: 0 auto;
            }

            .contact-card {
                background-color: var(--gray-999);
                border: 1px solid rgba(118, 17, 166, 0.12);
                border-radius: 28px;
                padding: 2.25rem;
                box-shadow: var(--shadow-sm);
            }

            .eyebrow {
                display: inline-flex;
                margin-bottom: 1rem;
                padding: 0.55rem 1rem;
                border-radius: 999px;
                background-color: rgba(118, 17, 166, 0.12);
                color: var(--accent-regular);
                font-size: 0.85rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.08em;
            }

            #comment__title {
                margin: 0 0 1rem 0;
                font-size: clamp(2rem, 2.5vw, 3rem);
                line-height: 1.05;
            }

            .contact-intro,
            .contact-note {
                color: var(--gray-400);
                line-height: 1.9;
            }

            .contact-intro {
                margin-bottom: 1.75rem;
            }

            .contact-details {
                display: grid;
                gap: 0.85rem;
                margin-bottom: 1.75rem;
            }

            .contact-details a {
                color: var(--link-color);
                text-decoration: none;
                font-weight: 600;
            }

            .contact-details a:hover {
                text-decoration: underline;
            }

            .contact-form label {
                margin-top: 1.25rem;
                color: var(--gray-200);
                font-weight: 600;
                display: block;
            }

            .contact-form input,
            .contact-form textarea {
                width: 100%;
                margin-top: 0.75rem;
                padding: 1rem 1.1rem;
                border-radius: 18px;
                border: 1px solid rgba(255, 255, 255, 0.2);
                background-color: #eae0e0;
                color: var(--gray-0);
                outline: none;
                font-size: 1rem;
                transition: border-color var(--theme-transition), box-shadow var(--theme-transition);
            }

            .contact-form input:focus,
            .contact-form textarea:focus {
                border-color: var(--accent-regular);
                box-shadow: 0 0 0 4px rgba(118, 17, 166, 0.1);
            }

            .contact-form textarea {
                min-height: 180px;
                resize: vertical;
            }

            .contact-form button {
                margin-top: 1.75rem;
                width: fit-content;
                padding: 1rem 1.6rem;
                border-radius: 999px;
                background: linear-gradient(135deg, var(--gradient-stop-1), var(--gradient-stop-2));
                color: white;
                border: none;
                cursor: pointer;
                font-weight: 700;
                transition: transform var(--theme-transition), filter var(--theme-transition);
            }

            .contact-form button:hover {
                transform: translateY(-2px);
                filter: brightness(1.05);
            }

            @media screen and (max-width: 900px) {
                .contact-grid {
                    grid-template-columns: 1fr;
                }
            }

            @media screen and (max-width: 580px) {
                .contact-card {
                    padding: 1.75rem;
                }

                #comment__title {
                    font-size: 2rem;
                }
            }
        </style>
    </div>
</BaseLayout>
