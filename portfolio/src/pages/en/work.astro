---
import BaseLayout from "../../layouts/BaseLayout.astro";

import ContactCTA from '../../components/ContactCTA.astro';
import Hero from "../../components/Hero.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
---

<BaseLayout
	title="My Work | Ousmane Diallo"
	description="Learn about Ousmane Diallo's most recent projects"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="My personal projects"
				tagline="A list of all my personal projects coded during recent times. You can find all my projects on my GitHub."
				align="start"
			/>
			<ProjectGrid lang="en" />
		</main>
		<ContactCTA lang="en" />
	</div>
</BaseLayout>
