---
import BaseLayout from "../../layouts/BaseLayout.astro";

import ContactCTA from "../../components/ContactCTA.astro";
import Hero from "../../components/Hero.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
---

<BaseLayout
	title="Mon travail | Ousmane Diallo"
	description="Découvrez les projets personnels de Mr Ousmane Diallo"
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Mes projets personnels"
				tagline="Une liste de l'ensemble de mes projets personnels codés durant ces derniers temps. Vous pouvez retrouver l'ensemble de mes projets sur mon GitHub."
				align="start"
			/>
			<ProjectGrid lang="fr" />
		</main>
		<ContactCTA lang="fr" />
	</div>
</BaseLayout>
