---
import '../../styles/skills.css';
---

<div><h1>Programming languages</h1></div>

<section class="box skills">
	<h2>Skills</h2>

	<div class="skills-categories">
		<!-- Frontend -->
		<div class="category">
			<h3 class="category-title">Frontend</h3>
			<div class="skills-grid">
				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/html-5.png" alt="HTML5"/>
					<div class="skill-body">
						<h4 class="skill-name">HTML5 <span class="skill-level">Expert</span></h4>
						<p class="skill-desc">Semantic structure and accessibility</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/css3.png" alt="CSS3"/>
					<div class="skill-body">
						<h4 class="skill-name">CSS3 <span class="skill-level">Confirmed</span></h4>
						<p class="skill-desc">Responsive, animations, modern layouts</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/javascript.png" alt="Javascript"/>
					<div class="skill-body">
						<h4 class="skill-name">JavaScript <span class="skill-level">Confirmed</span></h4>
						<p class="skill-desc">DOM, ES6+, fetch, small interactions</p>
					</div>
				</article>
			</div>
		</div>

		<!-- Backend -->
		<div class="category">
			<h3 class="category-title">Backend</h3>
			<div class="skills-grid">
				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/php.png" alt="PHP"/>
					<div class="skill-body">
						<h4 class="skill-name">PHP <span class="skill-level">Intermediate</span></h4>
						<p class="skill-desc">APIs, templating, gestion serveur</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/mysql-logo.png" alt="MySQL"/>
					<div class="skill-body">
						<h4 class="skill-name">MySQL <span class="skill-level">Intermediate</span></h4>
						<p class="skill-desc">Modeling and queries</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/java-coffee-cup-logo.png" alt="Java"/>
					<div class="skill-body">
						<h4 class="skill-name">Java <span class="skill-level">Beginner</span></h4>
						<p class="skill-desc">Object-oriented bases and framework</p>
					</div>
				</article>
			</div>
		</div>

		<!-- Outils -->
		<div class="category">
			<h3 class="category-title">Tools & DevOps</h3>
			<div class="skills-grid">
				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/git.png" alt="Git"/>
					<div class="skill-body">
						<h4 class="skill-name">Git <span class="skill-level">Confirmed</span></h4>
						<p class="skill-desc">Versioning, branches, workflow</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/bootstrap.png" alt="Bootstrap"/>
					<div class="skill-body">
						<h4 class="skill-name">Bootstrap <span class="skill-level">Intermediate</span></h4>
						<p class="skill-desc">Quick components and classes utilities</p>
					</div>
				</article>

				<article class="skill-card">
					<img class="skill-icon" src="https://img.icons8.com/color/48/000000/sql.png" alt="SQL"/>
					<div class="skill-body">
						<h4 class="skill-name">SQL <span class="skill-level">Intermediate</span></h4>
						<p class="skill-desc">Queries, joins and optimization</p>
					</div>
				</article>
			</div>
		</div>
	</div>
</section>

<style>
	.box {
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		padding: 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.skills h2 {
		font-size: var(--text-lg);
	}

	.skills p {
		color: var(--gray-400);
	}

	@media (min-width: 400px) {
		.skills {
			display: grid;
			grid-template-columns: repeat(2, auto);
			gap: 3rem;
		}

		h1 {
			font-size: 25px;
		}
	}

	@media (min-width: 768px) {
		.skills {
			grid-template-columns: repeat(3, 1fr);
			gap: 2.5rem;
		}
	}

	@media (min-width: 1024px) {
		.skills {
			grid-template-columns: repeat(4, 1fr);
			gap: 3rem;
		}
	}
</style>
