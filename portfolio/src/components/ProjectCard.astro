---
import type { Project, ProjectLang } from '../data/projects';

interface Props {
	project: Project;
	lang: ProjectLang;
}

const { project, lang } = Astro.props;
---

<article class="project-card">
	<div class="project-card-header">
		<div>
			<h2 class="project-title">{project.title[lang]}</h2>
			<div class="project-tags">
				{project.tags.map((tag) => (
					<span class="tag">{tag}</span>
				))}
			</div>
		</div>
		<span class="project-badge">
			{project.featured ? 'Featured' : 'Project'}
		</span>
	</div>

	<p class="project-description" set:html={project.description[lang]}></p>

	<div class="project-card-footer">
		<a
			href={project.repo.url}
			class="repo-link"
			target="_blank"
			rel="noopener noreferrer"
		>
			{project.repo.label[lang]}
		</a>
	</div>
</article>

<style>
	.project-card {
		background-color: var(--gray-999);
		border: 1px solid var(--gray-300);
		border-radius: 24px;
		padding: 28px;
		display: flex;
		flex-direction: column;
		min-height: 100%;
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.project-card:hover {
		transform: translateY(-8px); 
		box-shadow: var(--shadow-md);
		border-color: rgba(118, 17, 166, 0.15);
	}

	.project-card-header {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: flex-start;
		margin-bottom: 1rem;
	}

	.project-title {
		font-size: 1.5rem;
		margin: 0 0 0.75rem 0;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.tag {
		background-color: rgba(118, 17, 166, 0.08);
		color: var(--accent-regular);
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
		font-size: 0.85rem;
	}

	.project-badge {
		background: linear-gradient(135deg, var(--gradient-stop-1), var(--gradient-stop-2));
		color: white;
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.project-description {
		margin: 0 0 1.5rem 0;
		color: var(--gray-400);
		line-height: 1.75;
		flex-grow: 1;
	}

	.project-description :global(a) {
		color: var(--link-color);
		text-decoration: underline;
	}

	.project-card-footer {
		display: flex;
	}

	.repo-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background-color: var(--accent-regular);
		color: white;
		padding: 0.95rem 1.25rem;
		text-decoration: none;
		border-radius: 999px;
		font-weight: 600;
		transition: transform 0.2s ease, background-color 0.2s ease;
	}

	.repo-link:hover {
		background-color: var(--accent-dark);
		transform: translateY(-1px);
	}
</style>
